<%= form_with model: search, id: dom_id(search, :form) do |form| %>
  <div class="searches__input-container bordered vstack gap-none">
    <div class="bordered-block-end">
      <%= form.text_field :name, placeholder: "Name", class: "empty tall" %>
    </div>

    <div class="bordered-block-end">
      <%= form.text_area :notes, placeholder: "Notes", class: "empty", rows: 3 %>
    </div>

    <div class="hstack gap-none query-field bordered-block-end">
      <%= form.text_field :query, placeholder: random_book_title, class: "empty tall" %>
    </div>

    <div class="padding searches__filter-fieldset vstack bordered-block-end">
      <div class="searches__filter-field">
        <%= form.label :category_ids, "Category" %>
        <%= form.select :category_ids, Search.category_options_for_select, include_blank: "All categories" %>
      </div>

      <div class="searches__filter-field">
        <%= form.label :buying_options %>
        <%= form.select :buying_options, Search.buying_options_for_select, include_blank: "Unspecified" %>
      </div>

      <div class="searches__filter-field">
        <%= form.label :conditions %>
        <%= form.select :conditions, Search.condition_options_for_select, include_blank: "Unspecified" %>
      </div>

      <div class="searches__filter-field">
        <%= form.label :minimum %>
        <div class="currency">
          <%= form.text_field :minimum, placeholder: "0.00" %>
        </div>
      </div>

      <div class="searches__filter-field">
        <%= form.label :maximum %>
        <div class="currency">
          <%= form.text_field :maximum, placeholder: "100.00" %>
        </div>
      </div>

      <div class="searches__filter-field">
        <%= form.label :search_in_description %>
        <div style="height: 2.5rem;"><%= form.check_box :search_in_description %></div>
      </div>
    </div>

    <div class="padding">
      <div class="hstack gap-half">
        <span class="text-faint">Status:</span><%= search.status_in_database.capitalize %>
      </div>
    </div>
  </div>

  <div class="searches__form-actions bordered margin-block-start-double">
    <%= link_to searches_path, class: "btn btn-ghost bordered-inline-end square" do %>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="32"
        height="32"
        fill="#000000"
        viewBox="0 0 256 256"
      >
        <path
          d="M224,128a8,8,0,0,1-8,8H59.31l58.35,58.34a8,8,0,0,1-11.32,11.32l-72-72a8,8,0,0,1,0-11.32l72-72a8,8,0,0,1,11.32,11.32L59.31,120H216A8,8,0,0,1,224,128Z"
        ></path>
      </svg>
    <% end %>

    <%= form.button type: "submit", class: "btn-faint bordered-inline-start full-width" do %>
      <% if search.persisted? %>
        Update
      <% else %>
        Create
      <% end %>
    <% end %>
  </div>
<% end %>
