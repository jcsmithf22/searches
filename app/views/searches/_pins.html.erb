<section id="pins" class="tray tray--pins" data-controller="dialog">
  <%= tag.dialog id: "pin-tray", class: "tray__dialog", data: {
        action: "keydown->navigable-list#navigate dialog:show@document->navigable-list#reset keydown.esc->dialog#close:stop click@document->dialog#closeOnClickOutside",
        controller: "navigable-list",
        dialog_target: "dialog",
        navigable_list_actionable_items_value: "true",
        navigable_list_reverse_navigation_value: "true" },
        turbo_permanent: true do %>

      <% pins&.each do |pin| %>
        <div class="tray__item" data-navigable-list-target="item">
          <div class="preview">
            <%= pin.name %>
          </div>
        </div>
      <% end %>

  <% end %>

  <button class="exclude tray__toggle" data-action="dialog#toggle keydown.t@document->hotkey#click" data-controller="hotkey" aria-label="Toggle pins stack" aria-haspopup="true">
    <div class="tray__toggle-btn txt-uppercase center full-width">
    <span class="tray__toggle-text">Pinned</span>
    </div>
  </button>
</section>
