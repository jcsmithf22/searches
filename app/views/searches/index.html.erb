<div class="searches__logo small">
  <%= link_to root_path do %>
    <%= render "common/logo" %>
  <% end %>
</div>

<%= button_to "New search", searches_path(@search), method: :post, class: "", data: { controller: "hotkey", action: "keydown.c@document->hotkey#click" } %>

<div class="">
  <div class="vstack gap-double">
    <%= render "searches/forms/search", search: Search.new %>

    <% if @searches.any? %>
      <div class="vstack gap">
        <% @searches.each do |search| %>
          <%= render search %>
        <% end %>
      </div>
    <% else %>
      <div class="searches__empty padding-block-double">
        <div class="vstack gap centered">
          <p class="searches__empty-message">
            You haven't saved any searches yet.
          </p>

          <%= link_to "Create your first search", root_path, class: "link" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
