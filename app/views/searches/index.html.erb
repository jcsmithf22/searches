<div class="searches__logo small">
  <%= link_to root_path do %>
    <%= render "common/logo" %>
  <% end %>
</div>

<div>
  <div
    class="vstack gap-double"
    data-controller="navigable-list"
    data-action="
          keydown->navigable-list#navigate 
          click@document->navigable-list#deselectWhenClickingOutside
        "
  >
    <% if @searches.any? %>
      <div class="vstack gap">
        <%= render partial: "searches/display/preview", collection: @searches, as: :search %>
      </div>
    <% else %>
      <div class="searches__empty padding-block-double">
        <div class="vstack gap centered">
          <p class="searches__empty-message">
            You haven't saved any searches yet.
          </p>

          <%= link_to "Create your first search", root_path, class: "link" %>
        </div>
      </div>
    <% end %>
  </div>
</div>

<%= link_to "New search", new_search_path(), class: "margin-block-start", data: { controller: "hotkey", action: "keydown.c@document->hotkey#click" } %>
