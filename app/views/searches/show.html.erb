<div class="searches__logo small">
  <%= link_to root_path do %>
    <%= render "common/logo" %>
  <% end %>
</div>

<div class="bordered vstack gap-none">
  <div class="padding bordered-block-end">
    <p><%= @search.name %></p>

    <p><%= @search.query %></p>
  </div>

  <div class="padding">
    <div class="hstack gap-half">
      <span class="text-faint">Status:</span>
      <%= @search.status.capitalize %>
    </div>
  </div>
</div>

<div class="searches__toolbar bordered margin-block-start-double">
  <%= link_to searches_path, class: "btn btn-ghost bordered-inline-end square" do %>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="32"
      height="32"
      fill="#000000"
      viewBox="0 0 256 256"
    >
      <path
        d="M224,128a8,8,0,0,1-8,8H59.31l58.35,58.34a8,8,0,0,1-11.32,11.32l-72-72a8,8,0,0,1,0-11.32l72-72a8,8,0,0,1,11.32,11.32L59.31,120H216A8,8,0,0,1,224,128Z"
      ></path>
    </svg>
  <% end %>

  <%= link_to "Edit", edit_search_path(@search), class: "btn btn-faint bordered-inline full-width" %>

  <%= button_to search_publish_path(@search), method: :post, form: { class: "full-width" }, class: "btn-primary bordered-inline-start full-width" do %>
    <% if @search.published? %>
      Unpublish
    <% else %>
      Publish
    <% end %>
  <% end %>
</div>
