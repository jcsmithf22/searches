<%= form_with model: search do |form| %>
  <div class="searches__input-container bordered vstack gap-none">
    <div class="searches__form-actions bordered-block-end">
      <%= link_to searches_path, class: "btn btn-ghost bordered-inline-end" do %>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="32"
          height="32"
          fill="#000000"
          viewBox="0 0 256 256"
        >
          <path
            d="M224,128a8,8,0,0,1-8,8H59.31l58.35,58.34a8,8,0,0,1-11.32,11.32l-72-72a8,8,0,0,1,0-11.32l72-72a8,8,0,0,1,11.32,11.32L59.31,120H216A8,8,0,0,1,224,128Z"
          ></path>
        </svg>
      <% end %>

      <div class="flex-spacer"></div>

      <%= form.button :search_or_save, type: "submit", formaction: execute_searches_path, formmethod: "get", class: "btn-ghost bordered-inline", value: "search", data: { turbo_frame: "results" } do %>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="32"
          height="32"
          fill="#000000"
          viewBox="0 0 256 256"
        >
          <path
            d="M229.66,218.34l-50.07-50.06a88.11,88.11,0,1,0-11.31,11.31l50.06,50.07a8,8,0,0,0,11.32-11.32ZM40,112a72,72,0,1,1,72,72A72.08,72.08,0,0,1,40,112Z"
          ></path>
        </svg>
      <% end %>

      <%= form.button :search_or_save, type: "submit", class: "save-btn btn-ghost" do %>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="32"
          height="32"
          fill="#000000"
          viewBox="0 0 256 256"
        >
          <path
            d="M219.31,72,184,36.69A15.86,15.86,0,0,0,172.69,32H48A16,16,0,0,0,32,48V208a16,16,0,0,0,16,16H208a16,16,0,0,0,16-16V83.31A15.86,15.86,0,0,0,219.31,72ZM168,208H88V152h80Zm40,0H184V152a16,16,0,0,0-16-16H88a16,16,0,0,0-16,16v56H48V48H172.69L208,83.31ZM160,72a8,8,0,0,1-8,8H96a8,8,0,0,1,0-16h56A8,8,0,0,1,160,72Z"
          ></path>
        </svg>
      <% end %>
    </div>

    <div class="bordered-block-end">
      <%= form.text_field :name, placeholder: "Name", class: "empty tall" %>
    </div>

    <div class="bordered-block-end">
      <%= form.text_area :notes, placeholder: "Notes", class: "empty", rows: 3 %>
    </div>

    <div class="hstack gap-none query-field bordered-block-end">
      <%= form.text_field :query, placeholder: random_book_title, class: "empty tall" %>
    </div>

    <div class="padding searches__filter-fieldset vstack">
      <div class="searches__filter-field">
        <%= form.label :category_ids, "Category" %>
        <%= form.select :category_ids, Search.category_options_for_select, include_blank: "All categories" %>
      </div>

      <div class="searches__filter-field">
        <%= form.label :buying_options %>
        <%= form.select :buying_options, Search.buying_options_for_select, include_blank: "Unspecified" %>
      </div>

      <div class="searches__filter-field">
        <%= form.label :conditions %>
        <%= form.select :conditions, Search.condition_options_for_select, include_blank: "Unspecified" %>
      </div>

      <div class="searches__filter-field">
        <%= form.label :minimum %>
        <div class="currency">
          <%= form.text_field :minimum, placeholder: "0.00" %>
        </div>
      </div>

      <div class="searches__filter-field">
        <%= form.label :maximum %>
        <div class="currency">
          <%= form.text_field :maximum, placeholder: "100.00" %>
        </div>
      </div>

      <div class="searches__filter-field">
        <%= form.label :search_in_description %>
        <div><%= form.check_box :search_in_description %></div>
      </div>
    </div>
  </div>
<% end %>
