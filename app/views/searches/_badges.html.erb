<div id="<%= dom_id(search, :badges) %>" class="padding hstack gap-half">
  <%= tag.div class: "badge #{search.published? && "primary"}" do %>
    <%= search.status %>
  <% end %>

  <% if search.search_in_description %>
    <div class="badge">
      Search in description
    </div>
  <% end %>

  <% if search.pinned_by?(Current.user) %>
    <div class="badge information">
      Pinned
    </div>
  <% end %>
</div>
