<div
  id="<%= dom_id(search, :toolbar) %>"
  class="searches__toolbar bordered margin-block-start-double"
>
  <%= link_to searches_path, class: "btn btn-ghost bordered-inline-end square", data: { controller: "hotkey", action: "keydown.esc@document->hotkey#click" } do %>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="32"
      height="32"
      fill="#000000"
      viewBox="0 0 256 256"
    >
      <path
        d="M224,128a8,8,0,0,1-8,8H59.31l58.35,58.34a8,8,0,0,1-11.32,11.32l-72-72a8,8,0,0,1,0-11.32l72-72a8,8,0,0,1,11.32,11.32L59.31,120H216A8,8,0,0,1,224,128Z"
      ></path>
    </svg>
  <% end %>

  <%= link_to "Edit", edit_search_path(search), class: "btn btn-faint bordered-inline-end full-width", data: { controller: "hotkey", action: "keydown.e@document->hotkey#click" } %>

  <%= button_to search_publish_path(search), method: :patch, form: { class: "full-width" }, class: "btn-primary bordered-inline-end full-width",
        name: "status", value: search.published? ? "inactive" : "active", data: { controller: "hotkey", action: "keydown.p@document->hotkey#click" } do %>
    <% if search.published? %>
      Deactivate
    <% else %>
      Activate
    <% end %>
  <% end %>

  <%= button_to search, method: :delete, class: "btn btn-danger square", data: { turbo_confirm: "Are you sure?", controller: "hotkey", action: "keydown.d@document->hotkey#click" } do %>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="20"
      height="20"
      fill="currentColor"
      viewBox="0 0 256 256"
    >
      <path
        d="M216,48H40a8,8,0,0,0,0,16h8V208a16,16,0,0,0,16,16H192a16,16,0,0,0,16-16V64h8a8,8,0,0,0,0-16ZM192,208H64V64H192ZM80,24a8,8,0,0,1,8-8h80a8,8,0,0,1,0,16H88A8,8,0,0,1,80,24Z"
      ></path>
    </svg>
  <% end %>
</div>
